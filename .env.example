# =============================================================================
# DocSearch - server arteloka (VPS 8GB RAM, tier max throughput)
# Port terpakai di arteloka: 3001 (app), 5432 (postgres), 3040 (whatsapp)
# DocSearch: APP 3002, PG localhost:5434, Redis localhost:6380, Paperless localhost:8000
#
#   cp .env.example .env && nano .env
#   ./scripts/server-up.sh
# =============================================================================

COMPOSE_PROFILES=prod

# --- PostgreSQL (container sendiri, BUKAN arteloka-db di :5432) ---
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST_PORT=5434
POSTGRES_MEM_LIMIT=1536m
# Shared by Paperless + Prisma app/worker (default Postgres is 100)
POSTGRES_MAX_CONNECTIONS=200

# --- Redis (noeviction untuk BullMQ queue) ---
REDIS_HOST_PORT=6380
REDIS_MEM_LIMIT=512m
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=noeviction

# --- Paperless-ngx (OCR: bottleneck utama bulk sync) ---
PAPERLESS_SECRET_KEY=change-me-long-random-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-admin-password
PAPERLESS_ADMIN_MAIL=admin@organisasi.go.id
PAPERLESS_URL=http://127.0.0.1:8000
PAPERLESS_HOST_PORT=8000
PAPERLESS_API_TOKEN=
PAPERLESS_MEM_LIMIT=3584m
PAPERLESS_TASK_WORKERS=5
PAPERLESS_THREADS_PER_WORKER=2
PAPERLESS_WEBSERVER_WORKERS=2
PAPERLESS_CONVERT_MEMORY_LIMIT=1024
PAPERLESS_CONSUMER_POLLING=3

# --- Portal (publik). arteloka = :3001 → DocSearch = :3002 ---
# Ganti SERVER_IP dengan IP publik / domain, contoh: http://203.0.113.10:3002
NEXTAUTH_URL=http://SERVER_IP:3002
NEXTAUTH_SECRET=change-me-nextauth-secret
AUTH_TRUST_HOST=true
APP_PORT=3002
APP_MEM_LIMIT=1024m

ADMIN_EMAIL=admin@organisasi.go.id
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

ENCRYPTION_KEY=change-me-32-characters-minimum!!

BAPPENAS_URL=https://cloud.bappenas.go.id
BAPPENAS_USERNAME=
BAPPENAS_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Admin audit: USD per 1M tokens (estimates only)
# OPENAI_PRICE_CHAT_INPUT_PER_MTok=0.15
# OPENAI_PRICE_CHAT_OUTPUT_PER_MTok=0.60
# OPENAI_PRICE_EMBED_PER_MTok=0.02
EMBED_BACKFILL_BATCH=35
EMBED_PAUSE_DURING_INGEST=true
# EMBED_TX_TIMEOUT_MS=60000
# ASK_FULL_DOC_MAX_CHARS=100000
# ASK_RANK_CONTENT_CHARS=48000
# ASK_CHUNK_SIZE=1500
# ASK_CHUNK_OVERLAP=200
# AI keyword planner before Paperless search (default on when OPENAI_API_KEY set)
# ASK_AI_SEARCH_KEYWORDS=true
# ASK_SEARCH_KEYWORDS_MIN=2
# ASK_SEARCH_KEYWORDS_MAX=5
# ASK_KEYWORD_MODEL=gpt-4o-mini
# ASK_ANALYZE_MODEL=gpt-4o
# ASK_DETAIL_MODEL=gpt-4o-mini
# ASK_CHUNK_DOC_LIMIT=8
# ASK_CHUNK_ROW_LIMIT=2500
# ASK_RETRIEVAL_MIN_SCORE=0.28
# ASK_AGENT_SECOND_PASS=true
# ASK_MAP_REDUCE_ENABLED=true
# ASK_MAP_REDUCE_MIN_CHARS=80000
# ASK_MAP_BATCH_CHARS=32000
# ASK_MAP_MODEL=gpt-4o-mini
# ASK_VERIFY_ANSWER=true
# ASK_VERIFY_MODEL=gpt-4o-mini
# ASK_VERIFY_CONTEXT_CHARS=40000
# D1-D3 Ask accuracy (defaults on where noted)
# ASK_AUTO_FOCUS_RATIO=1.5
# ASK_MIN_OCR_CHARS=100
# ASK_HYDE_ENABLED=true
# ASK_HYDE_MODEL=gpt-4o-mini
# ASK_RERANK_ENABLED=true
# ASK_RERANK_MODEL=gpt-4o-mini
# ASK_RERANK_POOL=30
# ASK_PGVECTOR_TOP_K=80
# ASK_SEARCH_CACHE=true
# ASK_SEARCH_CACHE_TTL_MS=60000
# ASK_AGENT_LOOP=false
# ASK_AGENT_MAX_PASSES=2
# ASK_DOC_SUMMARY_ENABLED=true
# ASK_SUMMARY_MODEL=gpt-4o-mini
# ASK_VISION_ENABLED=true
# ASK_VISION_MODEL=gpt-4o-mini

# --- Sync throughput (tier max 8GB shared) ---
SYNC_POLL_INTERVAL_MS=900000
SCAN_MAX_FILES=750
SCAN_DISCOVER_CONCURRENCY=12
SCAN_INGEST_CONCURRENCY=12
WEBDAV_DISCOVERY_CONCURRENCY=24
WEBDAV_DOWNLOAD_CONCURRENCY=14
# Shared PROPFIND+download cap when discovery overlaps ingest
WEBDAV_TOTAL_CONCURRENCY=28
INGEST_MAX_RETRY_COUNT=5
# Worker auto-retry schedule: max 1 pick per FAILED file (default 1)
INGEST_AUTO_RETRY_MAX=1
# Prisma pools (app + worker) must fit under POSTGRES_MAX_CONNECTIONS with Paperless
PRISMA_CONNECTION_LIMIT_APP=8
PRISMA_CONNECTION_LIMIT_WORKER=16
PRISMA_POOL_TIMEOUT=30
FOLDER_SNAPSHOT_UPSERT_CONCURRENCY=4
FOLDER_SNAPSHOT_BATCH_SIZE=40
# Chase next delta waits while pg_stat_activity >= this (max_connections=200)
DB_HOT_CLIENTS_THRESHOLD=130
DB_HOT_MAX_WAIT_MS=120000
# Legacy; chase no longer walks on this timer (interval auto-scan does forceWalk)
FULL_WALK_INTERVAL_MS=10800000
SCAN_STUCK_JOB_MINUTES=45
POST_SYNC_WARM_ENABLED=true
POST_SYNC_WARM_MAX_DIRS=40
# SYNC_WORKER_SHARD_COUNT=1
# SYNC_WORKER_SHARD_INDEX=0
# WEBDAV_DOWNLOAD_TIMEOUT_MS=120000
OCR_PENDING_TIMEOUT_MINUTES=180
OCR_RECONCILE_INTERVAL_MS=5000
OCR_RECONCILE_BATCH=300
# CLOUD_LIVE_SUMMARY_TTL_SEC=1800
# CLOUD_LIVE_SCAN_MAX_DIRS=2000
# CLOUD_LISTING_CACHE_TTL_SEC=600
STUCK_SYNC_MINUTES=60
SYNC_WORKER_MEM_LIMIT=1536m

# PAPERLESS_OCR_LANGUAGE=ind

TZ=Asia/Jakarta

# --- WhatsApp bot integration (open API, fixed portal user) ---
# WHATSAPP_USER_EMAIL=triando@gmail.com
# WHATSAPP_FILE_MAX_BYTES=15728640
