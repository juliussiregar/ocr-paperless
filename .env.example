# =============================================================================
# DocSearch - env untuk server upgraded (RAM lebih besar)
# Port terpakai di arteloka: 3001 (app), 5432 (postgres), 3040 (whatsapp)
# DocSearch memakai: APP 3002, PG localhost:5434, Redis localhost:6380, Paperless localhost:8000
#
#   cp .env.example .env && nano .env
#   ./scripts/server-up.sh
# =============================================================================

COMPOSE_PROFILES=prod

# --- PostgreSQL (container sendiri, BUKAN arteloka-db di :5432) ---
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST_PORT=5434
POSTGRES_MEM_LIMIT=1536m

# --- Redis ---
REDIS_HOST_PORT=6380
REDIS_MEM_LIMIT=512m
REDIS_MAXMEMORY=384mb

# --- Paperless-ngx ---
PAPERLESS_SECRET_KEY=change-me-long-random-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-admin-password
PAPERLESS_ADMIN_MAIL=admin@organisasi.go.id
PAPERLESS_URL=http://127.0.0.1:8000
PAPERLESS_HOST_PORT=8000
PAPERLESS_API_TOKEN=
PAPERLESS_MEM_LIMIT=3072m
PAPERLESS_TASK_WORKERS=3
PAPERLESS_THREADS_PER_WORKER=2
PAPERLESS_WEBSERVER_WORKERS=2
PAPERLESS_CONVERT_MEMORY_LIMIT=768

# --- Portal (publik). arteloka = :3001 → DocSearch = :3002 ---
# Ganti SERVER_IP dengan IP publik / domain, contoh: http://203.0.113.10:3002
NEXTAUTH_URL=http://SERVER_IP:3002
NEXTAUTH_SECRET=change-me-nextauth-secret
AUTH_TRUST_HOST=true
APP_PORT=3002
APP_MEM_LIMIT=1024m

ADMIN_EMAIL=admin@organisasi.go.id
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

ENCRYPTION_KEY=change-me-32-characters-minimum!!

BAPPENAS_URL=https://cloud.bappenas.go.id
BAPPENAS_USERNAME=
BAPPENAS_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Admin audit: USD per 1M tokens (estimates only)
# OPENAI_PRICE_CHAT_INPUT_PER_MTok=0.15
# OPENAI_PRICE_CHAT_OUTPUT_PER_MTok=0.60
# OPENAI_PRICE_EMBED_PER_MTok=0.02
# How many OCR_DONE docs without chunks to embed per poll (sync-worker)
EMBED_BACKFILL_BATCH=25
# Ask AI: full OCR context for analysis (chars per doc, not summary)
# ASK_FULL_DOC_MAX_CHARS=100000
# ASK_RANK_CONTENT_CHARS=48000
# ASK_CHUNK_SIZE=1500
# ASK_CHUNK_OVERLAP=200

# --- Sync (server upgraded: throughput lebih tinggi) ---
SYNC_POLL_INTERVAL_MS=900000
# Sync otomatis hanya dari toggle Admin (bukan env)
SCAN_MAX_FILES=150
SCAN_DISCOVER_CONCURRENCY=6
SCAN_INGEST_CONCURRENCY=6
WEBDAV_DISCOVERY_CONCURRENCY=32
WEBDAV_DOWNLOAD_CONCURRENCY=6
INGEST_MAX_RETRY_COUNT=5
SCAN_STUCK_JOB_MINUTES=45
# Invalidate + warm listing cache setelah sync (default on)
POST_SYNC_WARM_ENABLED=true
POST_SYNC_WARM_MAX_DIRS=24
# Multi sync-worker: SYNC_WORKER_SHARD_COUNT=2 + index 0/1 per container
# SYNC_WORKER_SHARD_COUNT=1
# SYNC_WORKER_SHARD_INDEX=0
# Abort hung downloads (empty / stuck WebDAV streams), default 120s
# WEBDAV_DOWNLOAD_TIMEOUT_MS=120000
OCR_PENDING_TIMEOUT_MINUTES=180
# How often sync-worker checks Paperless for finished OCR (ms). Default 15000.
OCR_RECONCILE_INTERVAL_MS=10000
# Live cloud summary cache (Search + Library), default 30 min
# CLOUD_LIVE_SUMMARY_TTL_SEC=1800
# Max folders visited per live scan, default 2000
# CLOUD_LIVE_SCAN_MAX_DIRS=2000
# Per-folder listing cache (Library browse/tree), default 10 min
# CLOUD_LISTING_CACHE_TTL_SEC=600
STUCK_SYNC_MINUTES=60
SYNC_WORKER_MEM_LIMIT=1536m

# Optional Paperless speed knobs (keep conservative on 4GB VPS)
PAPERLESS_CONSUMER_POLLING=5
# PAPERLESS_TASK_WORKERS=1
# PAPERLESS_THREADS_PER_WORKER=1
# PAPERLESS_OCR_LANGUAGE=ind

TZ=Asia/Jakarta

# --- WhatsApp bot integration (open API, fixed portal user) ---
# WHATSAPP_USER_EMAIL=triando@gmail.com
# Max PDF bytes per file in chat response (base64), default 15MB
# WHATSAPP_FILE_MAX_BYTES=15728640
