# =============================================================================
# DocSearch / OCR Paperless - environment untuk Docker Compose
# Server (tanpa Nginx): salin ke .env, isi nilai di bawah, lalu:
#   ./scripts/server-up.sh
# =============================================================================

# Wajib di server agar service `app` (Next.js) ikut naik.
# Lokal + `npm run dev`: kosongkan / hapus baris ini.
COMPOSE_PROFILES=prod

# --- PostgreSQL ---
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-strong-password

# --- Paperless-ngx ---
PAPERLESS_SECRET_KEY=change-me-long-random-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-admin-password
PAPERLESS_ADMIN_MAIL=admin@organisasi.go.id
# URL browser ke Paperless (hanya localhost di server; pakai SSH tunnel jika perlu)
PAPERLESS_URL=http://127.0.0.1:8000
# Isi SETELAH Paperless jalan: Profile → API Auth Tokens → Create
PAPERLESS_API_TOKEN=

# --- Portal Next.js (publik, tanpa Nginx) ---
# Ganti IP/hostname server. Contoh: http://203.0.113.10:3000
NEXTAUTH_URL=http://SERVER_IP:3000
NEXTAUTH_SECRET=change-me-nextauth-secret
APP_PORT=3000

# Admin portal (di-seed otomatis saat container app start)
ADMIN_EMAIL=admin@organisasi.go.id
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

# Enkripsi kredensial Bappenas di DB (min 32 karakter; jangan diganti setelah ada data)
ENCRYPTION_KEY=change-me-32-characters-minimum!!

# Cloud Bappenas (opsional di seed; user isi sendiri di Profil)
BAPPENAS_URL=https://cloud.bappenas.go.id
BAPPENAS_USERNAME=
BAPPENAS_PASSWORD=

# OpenAI - hanya fitur Tanya AI (bukan OCR)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Sync / scan ---
SYNC_POLL_INTERVAL_MS=900000
AUTO_SCAN_ENABLED=false
SCAN_MAX_FILES=50
WEBDAV_DISCOVERY_CONCURRENCY=16
WEBDAV_DOWNLOAD_CONCURRENCY=2
OCR_PENDING_TIMEOUT_MINUTES=180
STUCK_SYNC_MINUTES=60

TZ=Asia/Jakarta
