# PostgreSQL
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-strong-password

# Paperless-ngx
PAPERLESS_SECRET_KEY=change-me-long-random-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-admin-password
PAPERLESS_ADMIN_MAIL=admin@organisasi.go.id
# URL untuk buka Paperless admin di browser (localhost / SSH tunnel)
PAPERLESS_URL=http://127.0.0.1:8000
# Dapatkan token dari Paperless UI: Profile → API Auth Tokens → Create
PAPERLESS_API_TOKEN=

# Cloud Bappenas — opsional untuk seed admin saja.
# User biasa mengisi username/password Bappenas saat register / di Profil.
BAPPENAS_URL=https://cloud.bappenas.go.id
BAPPENAS_USERNAME=
BAPPENAS_PASSWORD=
ADMIN_BAPPENAS_USERNAME=
ADMIN_BAPPENAS_PASSWORD=

# Next.js Auth — pakai URL publik server (tanpa Nginx)
# Contoh: http://192.168.1.10:3000  atau  http://docsearch.example.com:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-nextauth-secret
APP_PORT=3000

# Admin app (di-seed otomatis saat container `app` start)
ADMIN_EMAIL=admin@organisasi.go.id
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

# Encryption key for stored credentials (min 32 chars)
ENCRYPTION_KEY=change-me-32-characters-minimum!!

# OpenAI — hanya untuk fitur "Tanya AI" (bukan untuk scan/OCR)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Sync settings (900000 = 15 menit)
SYNC_POLL_INTERVAL_MS=900000
AUTO_SCAN_ENABLED=false
# Batas PDF per batch untuk semua mode ingest (0 = tanpa batas)
SCAN_MAX_FILES=50
OCR_PENDING_TIMEOUT_MINUTES=180
STUCK_SYNC_MINUTES=60

TZ=Asia/Jakarta
