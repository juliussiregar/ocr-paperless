# =============================================================================
# DocSearch - env wajib (isi semua; jangan biarkan change-me / SERVER_IP)
#
#   cp .env.example .env && nano .env
#   ./scripts/client-up.sh
#
# Opsi lanjutan (tuning OCR/Ask/memori): lihat .env.example.full
# =============================================================================

COMPOSE_PROFILES=prod

# Database
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST_PORT=5434

# Redis
REDIS_HOST_PORT=6380

# Paperless (OCR)
PAPERLESS_SECRET_KEY=change-me-long-random-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-admin-password
PAPERLESS_ADMIN_MAIL=admin@organisasi.go.id
PAPERLESS_URL=http://127.0.0.1:8000
PAPERLESS_HOST_PORT=8000
# Diisi setelah Paperless jalan (Profile → API Auth Tokens)
PAPERLESS_API_TOKEN=

# Portal (ganti SERVER_IP / domain)
NEXTAUTH_URL=http://SERVER_IP:3002
NEXTAUTH_SECRET=change-me-nextauth-secret
AUTH_TRUST_HOST=true
APP_PORT=3002

ADMIN_EMAIL=admin@organisasi.go.id
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

# Minimal 32 karakter (acak)
ENCRYPTION_KEY=change-me-32-characters-minimum!!

# Cloud WebDAV (opsional di sini; user bisa isi dari halaman Akun)
BAPPENAS_URL=https://cloud.bappenas.go.id

# Wajib untuk Tanya Arsip + embedding pencarian
OPENAI_API_KEY=
