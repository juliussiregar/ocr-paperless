# =============================================================================
# DocSearch - env untuk server bersama (contoh: arteloka VPS ~4GB RAM)
# Port terpakai di arteloka: 3001 (app), 5432 (postgres), 3040 (whatsapp)
# DocSearch memakai: APP 3002, PG localhost:5434, Redis localhost:6380, Paperless localhost:8000
#
#   cp .env.example .env && nano .env
#   ./scripts/server-up.sh
# =============================================================================

COMPOSE_PROFILES=prod

# --- PostgreSQL (container sendiri, BUKAN arteloka-db di :5432) ---
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST_PORT=5434
POSTGRES_MEM_LIMIT=512m

# --- Redis ---
REDIS_HOST_PORT=6380
REDIS_MEM_LIMIT=128m

# --- Paperless-ngx (hemat OCR) ---
PAPERLESS_SECRET_KEY=change-me-long-random-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-admin-password
PAPERLESS_ADMIN_MAIL=admin@organisasi.go.id
PAPERLESS_URL=http://127.0.0.1:8000
PAPERLESS_HOST_PORT=8000
PAPERLESS_API_TOKEN=
PAPERLESS_MEM_LIMIT=1536m
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=1
PAPERLESS_WEBSERVER_WORKERS=1
PAPERLESS_CONVERT_MEMORY_LIMIT=256

# --- Portal (publik). arteloka = :3001 → DocSearch = :3002 ---
# Ganti SERVER_IP dengan IP publik / domain, contoh: http://203.0.113.10:3002
NEXTAUTH_URL=http://SERVER_IP:3002
NEXTAUTH_SECRET=change-me-nextauth-secret
AUTH_TRUST_HOST=true
APP_PORT=3002
APP_MEM_LIMIT=512m

ADMIN_EMAIL=admin@organisasi.go.id
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Administrator

ENCRYPTION_KEY=change-me-32-characters-minimum!!

BAPPENAS_URL=https://cloud.bappenas.go.id
BAPPENAS_USERNAME=
BAPPENAS_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Sync (ringan di VPS kecil) ---
SYNC_POLL_INTERVAL_MS=900000
AUTO_SCAN_ENABLED=false
SCAN_MAX_FILES=20
WEBDAV_DISCOVERY_CONCURRENCY=6
WEBDAV_DOWNLOAD_CONCURRENCY=1
OCR_PENDING_TIMEOUT_MINUTES=180
# How often sync-worker checks Paperless for finished OCR (ms). Default 15000.
OCR_RECONCILE_INTERVAL_MS=15000
STUCK_SYNC_MINUTES=60
SYNC_WORKER_MEM_LIMIT=512m

# Optional Paperless speed knobs (keep conservative on 4GB VPS)
PAPERLESS_CONSUMER_POLLING=5
# PAPERLESS_TASK_WORKERS=1
# PAPERLESS_THREADS_PER_WORKER=1
# PAPERLESS_OCR_LANGUAGE=ind

TZ=Asia/Jakarta
